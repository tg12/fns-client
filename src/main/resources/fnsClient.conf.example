## runtime config
runtime.mode="replay"
runtime.replayPath="docker/replay-data"
runtime.deterministicSeed=7
runtime.validateOnStartup=false

## logging config
logging.level="INFO"

## jms config
## set runtime.mode="live" and jms.enabled=true to consume the real SWIM AIM FNS stream
## register for SWIM credentials at https://www.faa.gov/air_traffic/technology/swim
jms.enabled=false
jms.initialContextFactory="com.solacesystems.jndi.SolJNDIInitialContextFactory"
jms.providerUrl="tcps://ems1.swim.faa.gov:55443"
jms.username="YOUR_SWIM_USERNAME"
jms.password="YOUR_SWIM_PASSWORD"
jms.solace.messageVpn="AIM_FNS"
jms.solace.sslTrustStore=""
jms.solace.validateCertificate=false
jms.solace.jndiConnectionRetries=-1
jms.connectionFactory="YOUR_CONNECTION_FACTORY"
jms.destination="YOUR_QUEUE_DESTINATION"
jms.messageProcessor.processingThreads=4

## fil config
## FIL private key must be RSA PEM format
## convert with: ssh-keygen -p -N "" -m pem -f /path/to/key
## live startup will still run in JMS-only mode until FIL settings are provided
fil.sftp.host=""
fil.sftp.port=22
fil.sftp.username=""
fil.sftp.strictHostKeyChecking=no
fil.sftp.knownHostsFilePath=""
fil.sftp.certFilePath=""
fil.sftp.filFileSavePath="/app/docker/fil-cache"

## database config
## local docker stack defaults to postgres
notamDb.driver="org.postgresql.Driver"
notamDb.connectionUrl="jdbc:postgresql://postgres:5432/fns"
notamDb.username="fns"
notamDb.password="fns"
notamDb.schema="public"
notamDb.table="NOTAMS"
notamDb.initializationRetryCount=3
notamDb.removeOldNotams.enabled=true
notamDb.removeOldNotams.frequency=24

## message tracker config
messageTracker.scheduleRate=10
messageTracker.missedMessageTriggerTime=5
messageTracker.staleMessageTriggerTime=10

## rest api config
restapi.enabled=true
restapi.port=8080
